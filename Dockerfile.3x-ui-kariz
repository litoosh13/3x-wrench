# ===========================================================================
# 3x-ui panel + Kariz in ONE image.
#
# Why one image: PaaS providers that build from a Dockerfile give you a single
# container, and you only get ports/volumes/env AFTER the build.
#
#   kariz    ->  started in the background only when KARIZ_ROLE is set
#   3x-ui panel ->  0.0.0.0:2053 (map this one in the provider's panel)
#
# Leave KARIZ_ROLE unset and you get a plain 3x-ui panel with no tunnel.
#
#   KARIZ_ROLE=entry|exit  KARIZ_TOKEN=...  KARIZ_TRANSPORT=tcpmux  KARIZ_MODE=reverse
#   entry: KARIZ_LISTEN=0.0.0.0:3080 (reverse) or KARIZ_REMOTE=exit:3080 (direct)
#          KARIZ_FORWARD=443=127.0.0.1:443,8080=127.0.0.1:80
#   exit : KARIZ_REMOTE=entry:3080 (reverse) or KARIZ_LISTEN=0.0.0.0:3080 (direct)
#   ws/wss: KARIZ_WS_PATH=/api/v1/stream  KARIZ_WS_HOST=tunnel.example.com
#   quic: KARIZ_QUIC_OBFS=true KARIZ_QUIC_CONGESTION=bbr   kcp: KARIZ_KCP_MODE=fast2 KARIZ_KCP_FEC=10,3
#   KARIZ_FORWARD item suffix: /tcp (default), /udp or /tcp+udp

# Same deliberate omissions as Dockerfile.3x-ui -- do not "modernise" them:
#   * no `# syntax=` line  -> never pulls the docker/dockerfile frontend image
#   * no heredoc, no COPY  -> some builders get the Dockerfile alone, no context
#   * no Go/Rust/npm build -> every binary comes from a GitHub release
#
#   https://github.com/Erfan-XRay/Kariz   (see its LICENSE)
#   https://github.com/MHSanaei/3x-ui            (GPL-3.0)
# ===========================================================================

# --------------------------- download stage -------------------------------
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl && rm -rf /var/lib/apt/lists/*

# REF / XUI_REF = latest -> newest release of each project. Pin with --build-arg.
ARG REF=latest
ARG XUI_REF=latest
ARG TARGETARCH
ARG TARGETVARIANT

# No `#` comments inside the RUN below: Docker joins continuation lines into a
# single shell line, so a comment would swallow everything after it. Note the
# armv7 rename -- the panel maps GOARCH=arm to "arm32" (internal/xray/process.go),
# so without it the panel cannot find the Xray binary it just shipped.
RUN set -eu; \
    case "${TARGETARCH:-amd64}${TARGETVARIANT:-}" in \
      amd64)  ARCH=amd64;  TARCH=x86_64 ;; \
      arm64)  ARCH=arm64;  TARCH=aarch64 ;; \
      armv7)  ARCH=armv7;  TARCH=armv7 ;; \
      *) echo "unsupported arch: ${TARGETARCH:-}${TARGETVARIANT:-}" >&2; exit 1 ;; \
    esac; \
    if [ "$XUI_REF" = "latest" ]; then \
      XUI_URL="https://github.com/MHSanaei/3x-ui/releases/latest/download/x-ui-linux-${ARCH}.tar.gz"; \
    else \
      XUI_URL="https://github.com/MHSanaei/3x-ui/releases/download/${XUI_REF}/x-ui-linux-${ARCH}.tar.gz"; \
    fi; \
    if [ "$REF" = "latest" ]; then \
      REF=$(curl -fsSLI -o /dev/null -w '%{url_effective}' https://github.com/Erfan-XRay/Kariz/releases/latest); \
      REF=${REF##*/}; \
    fi; \
    NAME="kariz-${REF}-${TARCH}-linux"; \
    BASE="https://github.com/Erfan-XRay/Kariz/releases/download/${REF}"; \
    echo "downloading ${BASE}/${NAME}.tar.gz"; \
    curl -fL --retry 3 -o "/tmp/${NAME}.tar.gz" "${BASE}/${NAME}.tar.gz"; \
    curl -fL --retry 3 -o "/tmp/${NAME}.tar.gz.sha256" "${BASE}/${NAME}.tar.gz.sha256"; \
    (cd /tmp && sha256sum -c "${NAME}.tar.gz.sha256"); \
    tar -xzf "/tmp/${NAME}.tar.gz" -C /tmp; \
    mkdir -p /out; \
    install -m 0755 "/tmp/${NAME}/kariz" /out/kariz; \
    mkdir -p /out /app; \
    echo "downloading ${XUI_URL}"; \
    curl -fL --retry 3 -o /tmp/x-ui.tar.gz "$XUI_URL"; \
    tar -xzf /tmp/x-ui.tar.gz -C /app --strip-components=1; \
    rm -f /tmp/x-ui.tar.gz; \
    chmod +x /app/x-ui /app/bin/xray-linux-* /app/bin/mtg-linux-* 2>/dev/null || true; \
    if [ "$ARCH" = "armv7" ]; then \
      mv /app/bin/xray-linux-armv7 /app/bin/xray-linux-arm32; \
      chmod +x /app/bin/xray-linux-arm32; \
    fi; \
    test -s /app/x-ui; \
    test -s /out/kariz

# ---------------------------- runtime stage -------------------------------
FROM debian:bookworm-slim

# Network-debugging toolbox (ping, dig, nc, traceroute, netstat, tcpdump) plus
# what the panel wants: certs, timezone, openssl for the SSL menu, bash+cron
# for acme.sh renewals.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates iproute2 libcap2-bin tini \
        iputils-ping dnsutils netcat-openbsd traceroute net-tools tcpdump \
        procps curl wget nano vim-tiny less \
        tzdata openssl bash cron \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/kariz /usr/local/bin/kariz
COPY --from=build /app/ /app/

# The panel resolves its Xray binary as "bin/xray-linux-*" relative to the
# working directory, so WORKDIR must be /app. The DB lives in /etc/x-ui.
RUN mkdir -p /data /etc/x-ui /var/log/x-ui
WORKDIR /app

# entrypoint.sh, base64-encoded so this Dockerfile needs no heredoc support
# and no external frontend. Decode it to read/edit:
#   docker run --rm --entrypoint sh IMAGE -c 'cat /usr/local/bin/entrypoint.sh'
RUN set -eu; printf '%s' \
    IyEvYmluL3NoCiMgM3gtdWkgcGFuZWwgKyBLYXJpeiB0dW5uZWwgaW4gb25lIGNvbnRhaW5lci4KIwojICAga2FyaXogICAtPiBz \
    dGFydHMgb25seSB3aGVuIEtBUklaX1JPTEUgaXMgc2V0LCBpbiB0aGUgYmFja2dyb3VuZCwgcmVzdGFydGVkIG9uIGV4aXQuCiMg \
    ICB4LXVpICAgIC0+IHJ1bnMgaW4gdGhlIGZvcmVncm91bmQgdW5sZXNzIFhVSV9FTkFCTEU9ZmFsc2UuCiMKIyBDb25maWcgaXMg \
    Z2VuZXJhdGVkIGZyb20gS0FSSVpfKiB2YXJpYWJsZXMuIERyb3AgYSBmdWxsIC9kYXRhL2thcml6LnRvbWwgb24gdGhlCiMgdm9s \
