    ZG9uZTsgfSAmCiAgICBUVU5ORUw9MQplbHNlCiAgICBsb2cgIktBUklaX1JPTEUgdW5zZXQgLT4gcGFuZWwgb25seSwgbm8gdHVu \
    bmVsLiIKZmkKCiMgWFVJX0VOQUJMRT1mYWxzZTogbm8gcGFuZWwsIHRoZSB0dW5uZWwgaXMgdGhlIG9ubHkgdGhpbmcgdGhpcyBj \
    b250YWluZXIgZG9lcy4KaWYgWyAiJHtYVUlfRU5BQkxFOi10cnVlfSIgPSAiZmFsc2UiIF07IHRoZW4KICAgIFsgLW4gIiRUVU5O \
    RUwiIF0gfHwgeyBsb2cgIkVSUk9SOiBYVUlfRU5BQkxFPWZhbHNlIGFuZCBubyB0dW5uZWwgY29uZmlndXJlZCwgbm90aGluZyB0 \
    byBydW4uIjsgZXhpdCAxOyB9CiAgICBsb2cgIlhVSV9FTkFCTEU9ZmFsc2UgLT4gcGFuZWwgb2ZmLCB0dW5uZWwgb25seSIKICAg \
    IHdhaXQKZmkKCmNkIC9hcHAKbG9nICJzdGFydGluZyAzeC11aSBwYW5lbCIKZXhlYyAvYXBwL3gtdWkK \
    | base64 -d > /usr/local/bin/entrypoint.sh; \
    chmod +x /usr/local/bin/entrypoint.sh

ENV XUI_IN_DOCKER="true" \
    XUI_MAIN_FOLDER="/app" \
    XUI_ENABLE_FAIL2BAN="false" \
    XRAY_VMESS_AEAD_FORCED="false"

# Nothing else gets an ENV default on purpose: an unset variable = the
# binary's own default. Set what you need in your provider's env panel.
EXPOSE 2053
VOLUME ["/etc/x-ui"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
