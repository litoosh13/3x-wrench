    eXBvaW50LnNoIGZyb20gdGhlIHZvbHVtZSIKICAgIGV4ZWMgL2Jpbi9zaCAvZGF0YS9lbnRyeXBvaW50LnNoICIkQCIKZmkKCmlm \
    IFsgIiQjIiAtZ3QgMCBdOyB0aGVuCiAgICBleGVjICIkQCIKZmkKCmlmIFsgLW4gIiR7S0FSSVpfUk9MRTotfSIgXTsgdGhlbgog \
    ICAgQz0vZXRjL2thcml6L2NvbmZpZy50b21sCiAgICBta2RpciAtcCAvZXRjL2thcml6CiAgICBpZiBbIC1mIC9kYXRhL2thcml6 \
