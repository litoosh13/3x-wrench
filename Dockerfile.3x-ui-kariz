    dCA9ICIlcyJcbicgIiRLQVJJWl9XU19IT1NUIgogICAgICAgICAgICBmaQogICAgICAgICAgICAjIEtBUklaX0ZPUldBUkQ9IjQ0 \
    Mz0xMjcuMC4wLjE6NDQzLDgwODA9MTI3LjAuMC4xOjgwIjsgYSBiYXJlIHBvcnQgbGlzdGVucyBvbiAwLjAuMC4wLgogICAgICAg \
    ICAgICBPTERJRlM9JElGUzsgSUZTPScsJwogICAgICAgICAgICBmb3IgZiBpbiAke0tBUklaX0ZPUldBUkQ6LX07IGRvCiAgICAg \
    ICAgICAgICAgICBsPSR7ZiUlPSp9OyB0PSR7ZiMqPX0KICAgICAgICAgICAgICAgIGNhc2UgIiRsIiBpbiAqOiopIDs7ICopIGw9 \
    IjAuMC4wLjA6JGwiIDs7IGVzYWMKICAgICAgICAgICAgICAgIHByaW50ZiAnW1tmb3J3YXJkXV1cbmxpc3RlbiA9ICIlcyJcbnRh \
    cmdldCA9ICIlcyJcbicgIiRsIiAiJHQiCiAgICAgICAgICAgIGRvbmUKICAgICAgICAgICAgSUZTPSRPTERJRlMKICAgICAgICB9 \
    ID4gIiRDIgogICAgZmkKICAgIGthcml6IGNoZWNrIC1jICIkQyIgPiYyIHx8IHsgbG9nICJFUlJPUjoga2FyaXogcmVqZWN0ZWQg \
