# ===========================================================================
# 3x-ui panel + SNI-Spoofing-Go in ONE image.
#
# Why one image: PaaS providers that build from a Dockerfile give you a single
# container, and you only get ports/volumes/env AFTER the build. Two containers
# cannot share 127.0.0.1, so the spoofer has to live next to the panel's Xray.
#
#   sni-spoofing  ->  127.0.0.1:2020  (loopback only; never exposed)
#   3x-ui panel   ->  0.0.0.0:2053    (map this one in the provider's panel)
#
# In the panel, point a VLESS *outbound* at 127.0.0.1:2020 and its whole TLS
# handshake goes out behind a decoy ClientHello. See README.md.
#
#   CONNECT=203.0.113.10:443  FAKE_SNI=hcaptcha.com  UTLS=firefox
#
# Leave CONNECT unset and you get a plain 3x-ui panel with no spoofing.
#
# Same three deliberate omissions as Dockerfile -- do not "modernise" them:
#   * no `# syntax=` line  -> never pulls the docker/dockerfile frontend image
#   * no heredoc           -> works on old builders and behind registry mirrors
#   * no Go/npm build      -> never contacts proxy.golang.org or npm (403 in Iran);
#                             both binaries come from GitHub releases
#
#   https://github.com/aleskxyz/SNI-Spoofing-Go  (GPL-3.0)
#   https://github.com/MHSanaei/3x-ui            (GPL-3.0)
# ===========================================================================

# --------------------------- download stage -------------------------------
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl && rm -rf /var/lib/apt/lists/*

# REF=latest -> newest release of each project. Pin with --build-arg.
ARG REF=latest
ARG XUI_REF=latest
ARG TARGETARCH
ARG TARGETVARIANT

# No `#` comments inside the RUN below: Docker joins continuation lines into a
# single shell line, so a comment would swallow everything after it. Note the
# armv7 rename -- the panel maps GOARCH=arm to "arm32" (internal/xray/process.go),
# so without it the panel cannot find the Xray binary it just shipped.
RUN set -eu; \
    case "${TARGETARCH:-amd64}${TARGETVARIANT:-}" in \
      amd64)  ARCH=amd64 ;; \
      arm64)  ARCH=arm64 ;; \
      armv7)  ARCH=armv7 ;; \
      *) echo "unsupported arch: ${TARGETARCH:-}${TARGETVARIANT:-}" >&2; exit 1 ;; \
    esac; \
    if [ "$REF" = "latest" ]; then \
      SNI_URL="https://github.com/aleskxyz/SNI-Spoofing-Go/releases/latest/download/sni-spoofing-linux-${ARCH}"; \
    else \
      SNI_URL="https://github.com/aleskxyz/SNI-Spoofing-Go/releases/download/${REF}/sni-spoofing-linux-${ARCH}"; \
    fi; \
    if [ "$XUI_REF" = "latest" ]; then \
      XUI_URL="https://github.com/MHSanaei/3x-ui/releases/latest/download/x-ui-linux-${ARCH}.tar.gz"; \
    else \
      XUI_URL="https://github.com/MHSanaei/3x-ui/releases/download/${XUI_REF}/x-ui-linux-${ARCH}.tar.gz"; \
    fi; \
    mkdir -p /out /app; \
    echo "downloading ${SNI_URL}"; \
    curl -fL --retry 3 -o /out/sni-spoofing "$SNI_URL"; \
    chmod +x /out/sni-spoofing; \
    echo "downloading ${XUI_URL}"; \
    curl -fL --retry 3 -o /tmp/x-ui.tar.gz "$XUI_URL"; \
    tar -xzf /tmp/x-ui.tar.gz -C /app --strip-components=1; \
    rm -f /tmp/x-ui.tar.gz; \
    chmod +x /app/x-ui /app/bin/xray-linux-* /app/bin/mtg-linux-* 2>/dev/null || true; \
    if [ "$ARCH" = "armv7" ]; then \
      mv /app/bin/xray-linux-armv7 /app/bin/xray-linux-arm32; \
      chmod +x /app/bin/xray-linux-arm32; \
    fi; \
    test -s /app/x-ui

# ---------------------------- runtime stage -------------------------------
FROM debian:bookworm-slim

# iptables AND iproute2 are both needed by the "active" (nfqueue) injector:
# it runs `ip route get` / `ip rule`. The second line is the network-debugging
# toolbox: ping, nslookup/dig, nc, traceroute, netstat/ifconfig, tcpdump.
# The third is what the panel itself wants: certs, timezone, openssl for the
# SSL menu, bash+cron for acme.sh renewals.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates iptables iproute2 libcap2-bin tini \
        iputils-ping dnsutils netcat-openbsd traceroute net-tools tcpdump \
        procps curl wget nano vim-tiny less \
        tzdata openssl bash cron \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/sni-spoofing /usr/local/bin/sni-spoofing
COPY --from=build /app/ /app/

# The panel resolves its Xray binary as "bin/xray-linux-*" relative to the
# working directory, so WORKDIR must be /app. The DB lives in /etc/x-ui.
RUN mkdir -p /data /etc/x-ui /var/log/x-ui
WORKDIR /app

# entrypoint.sh, base64-encoded so this Dockerfile needs no heredoc support
# and no external frontend. Decode it to read/edit:
#   docker run --rm --entrypoint sh IMAGE -c 'cat /usr/local/bin/entrypoint.sh'
RUN set -eu; printf '%s' \
    IyEvYmluL3NoCiMgM3gtdWkgcGFuZWwgKyBzbmktc3Bvb2ZpbmcgaW4gb25lIGNvbnRhaW5lci4KIwojICAgc25pLX \
    Nwb29maW5nICAtPiAgc3RhcnRzIG9ubHkgd2hlbiBDT05ORUNUIGlzIHNldCwgaW4gdGhlIGJhY2tncm91bmQsCiMg \
    ICAgICAgICAgICAgICAgICAgICBsaXN0ZW5pbmcgb24gMTI3LjAuMC4xOjIwMjAgYnkgZGVmYXVsdCBzbyB0aGUgcG \
    FuZWwncwojICAgICAgICAgICAgICAgICAgICAgWHJheSBjYW4gdXNlIGl0IGFzIGEgVkxFU1Mgb3V0Ym91bmQgdGFy \
    Z2V0LgojICAgeC11aSBwYW5lbCAgICAtPiAgYWx3YXlzIHJ1bnMsIGluIHRoZSBmb3JlZ3JvdW5kIChpdCBpcyBQSU \
    QgMSdzIGNoaWxkKS4Kc2V0IC1ldQoKbG9nKCkgeyBwcmludGYgJ1tlbnRyeXBvaW50XSAlc1xuJyAiJCoiID4mMjsg \
    fQoKIyAtLS0gb3ZlcnJpZGUgaG9vazogeW91ciBvd24gc2NyaXB0IG9uIHRoZSB2b2x1bWUgd2lucyAtLS0tLS0tLS \
