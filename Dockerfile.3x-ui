    8gInJvb3Q6ICAgICAgeWVzIgplbHNlCiAgICBlY2hvICJyb290OiAgICAgIE5PICAtPiBzbmktc3Bvb2ZpbmcgcmVm \
    dXNlcyB0byBzdGFydCBhcyBub24tcm9vdCIKICAgIFJDPTEKZmkKCmVjaG8gImNhcHM6ICAgICAgJHtDQVBTOi08Y2 \
    Fwc2ggdW5hdmFpbGFibGU+fSIKCmNhc2UgIiRDQVBTIiBpbgogICAgKmNhcF9uZXRfcmF3KnwiPWVwIiopCiAgICAg \
    ICAgZWNobyAiTkVUX1JBVzogICB5ZXMgLT4gcGFzc2l2ZSBpbmplY3RvciBjYW4gcnVuIiA7OwogICAgKikKICAgIC \
    AgICBlY2hvICJORVRfUkFXOiAgIE5PICAtPiBubyBpbmplY3Rpb24gaXMgcG9zc2libGU7IHRoZSBwbGF0Zm9ybSBz \
    dHJpcHBlZCBpdCIKICAgICAgICBSQz0xIDs7CmVzYWMKCmNhc2UgIiRDQVBTIiBpbgogICAgKmNhcF9uZXRfYWRtaW \
    4qfCI9ZXAiKikKICAgICAgICBlY2hvICJORVRfQURNSU46IHllcyAtPiB0aGUgYWN0aXZlIGluamVjdG9yIGlzIGF2 \
    YWlsYWJsZSB0b28iIDs7CiAgICAqKQogICAgICAgIGVjaG8gIk5FVF9BRE1JTjogbm8gIC0+IHBhc3NpdmUgaXMgYX \
