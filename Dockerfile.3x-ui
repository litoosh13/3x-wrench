    ZWQgKENPTk5FQ1QgdW5zZXQpIC0+IHBhbmVsIG9ubHkiCmVsaWYgbmMgLXogMTI3LjAuMC4xICIkUCIgMj4vZGV2L2 \
    51bGw7IHRoZW4KICAgIGVjaG8gInNwb29mZXI6ICAgbGlzdGVuaW5nIG9uIDEyNy4wLjAuMTokUCAtPiBwb2ludCB0 \
    aGUgVkxFU1Mgb3V0Ym91bmQgaGVyZSIKZWxzZQogICAgZWNobyAic3Bvb2ZlcjogICBOT1QgbGlzdGVuaW5nIG9uID \
    EyNy4wLjAuMTokUCAtPiByZWFkIHRoZSBjb250YWluZXIgbG9nIgogICAgUkM9MQpmaQoKWyAiJFJDIiAtZXEgMCBd \
    ICYmIGVjaG8gIiIgJiYgZWNobyAiT0s6IHNwb29maW5nIGNhbiB3b3JrIGhlcmUuIgpbICIkUkMiIC1uZSAwIF0gJi \
    YgZWNobyAiIiAmJiBlY2hvICJCUk9LRU46IHNlZSB0aGUgTk8vTk9UIGxpbmVzIGFib3ZlLiIKZXhpdCAiJFJDIgo= \
    | base64 -d > /usr/local/bin/sni-check; \
    chmod +x /usr/local/bin/sni-check

ENV XUI_IN_DOCKER="true" \
    XUI_MAIN_FOLDER="/app" \
    XUI_ENABLE_FAIL2BAN="false" \
    XRAY_VMESS_AEAD_FORCED="false"

# Nothing else gets an ENV default on purpose: an unset variable = the
# binary's own default. Set what you need in your provider's env panel.
EXPOSE 2053
VOLUME ["/etc/x-ui"]

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
