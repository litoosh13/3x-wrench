# sni-check: run it inside a running container to find out whether the platform
# really gave you root + CAP_NET_RAW, and whether the spoofer is listening:
#   docker exec <name> sni-check
RUN set -eu; printf '%s' \
    IyEvYmluL3NoCiMgQ2FuIHRoaXMgY29udGFpbmVyIGFjdHVhbGx5IGluamVjdCBwYWNrZXRzPyBFeGl0cyBub24tem \
    VybyBpZiBpdCBjYW5ub3QuCkNBUFM9IiQoY2Fwc2ggLS1wcmludCAyPi9kZXYvbnVsbCB8IHNlZCAtbiAncy9eQ3Vy \
