# ===========================================================================
# vpn-ui panel, containerised. No SNI spoofing -- see Dockerfile.3x-ui for that.
#
#   vpn-ui panel  ->  0.0.0.0:2083   (change the port in the panel UI)
#   database      ->  /etc/vpn-ui    (mount this)
#
# amd64 ONLY. Upstream publishes a single vpn-ui-amd64 asset and no arm64 build.
#
# READ THIS BEFORE DEPLOYING. vpn-ui is a 3x-ui fork whose selling point is
# L2TP, PPTP, OpenVPN, OpenConnect, SSTP, IKEv2, WireGuard and AmneziaWG. Those
# need CAP_NET_ADMIN, /dev/net/tun and kernel modules, and upstream installs
# them with a host deploy.sh -- it ships no container support at all. Run this
# on a VPS you control, with the modules loaded on the host FIRST; the panel
# installs a kernel package when it cannot find them, which in a container is
# both pointless and slow. DEPLOY.md has the host setup and the run command.
#
# On a managed container platform that grants no NET_ADMIN, only the Xray-core
# protocols can work -- and those are what plain 3x-ui already gives you.
#
# The Xray core and geofiles are bundled inside the panel binary, so there is
# no separate tarball to unpack.
#
# Same deliberate omissions as Dockerfile -- do not "modernise" them:
#   * no `# syntax=` line  -> never pulls the docker/dockerfile frontend image
#   * no heredoc           -> works on old builders and behind registry mirrors
#   * no Go build          -> never contacts proxy.golang.org (403 in Iran)
#
#   https://github.com/Sir-MmD/vpn-ui   (GPL-3.0)
# ===========================================================================

# --------------------------- download stage -------------------------------
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl && rm -rf /var/lib/apt/lists/*

ARG VPNUI_REF=latest
ARG TARGETARCH

# No `#` comments inside the RUN below: Docker joins continuation lines into a
# single shell line, so a comment would swallow everything after it.
RUN set -eu; \
    if [ "${TARGETARCH:-amd64}" != "amd64" ]; then \
      echo "vpn-ui publishes an amd64 binary only (got ${TARGETARCH})" >&2; exit 1; \
    fi; \
    if [ "$VPNUI_REF" = "latest" ]; then \
      URL="https://github.com/Sir-MmD/vpn-ui/releases/latest/download/vpn-ui-amd64"; \
    else \
      URL="https://github.com/Sir-MmD/vpn-ui/releases/download/${VPNUI_REF}/vpn-ui-amd64"; \
    fi; \
    mkdir -p /out; \
    echo "downloading ${URL}"; \
    curl -fL --retry 3 -o /out/vpn-ui "$URL"; \
    chmod +x /out/vpn-ui; \
    test -s /out/vpn-ui

# ---------------------------- runtime stage -------------------------------
FROM debian:bookworm-slim

# Debian 12 is one of the distributions upstream tests on, which is why this
# image is not Alpine.
#   kmod       -> modprobe. Without it the panel cannot load a kernel module
#                 even on a host that has them, and falls back to installing a
#                 kernel package.
#   libcap2-bin-> capsh, to check what capabilities the platform actually gave
#                 you before blaming the panel.
#   line 3     -> the network-debugging toolbox.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates iptables iproute2 kmod libcap2-bin tini \
        tzdata openssl bash cron procps curl wget nano vim-tiny less \
        iputils-ping dnsutils netcat-openbsd traceroute net-tools tcpdump \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/vpn-ui /app/vpn-ui

# The panel unpacks its bundled cores into ./bin, so WORKDIR matters. Without
# VPNUI_DB_FOLDER the database lands next to the binary in /app, which is not
# the volume -- so it is pinned to /etc/vpn-ui below.
RUN mkdir -p /etc/vpn-ui /var/log/vpn-ui /app/bin
WORKDIR /app

ENV VPNUI_DB_FOLDER="/etc/vpn-ui" \
    VPNUI_LOG_FOLDER="/var/log/vpn-ui" \
    XRAY_VMESS_AEAD_FORCED="false"

EXPOSE 2083
VOLUME ["/etc/vpn-ui"]

# tini reaps zombies: the panel forks VPN daemons that would otherwise pile up.
ENTRYPOINT ["/usr/bin/tini", "--", "/app/vpn-ui"]
