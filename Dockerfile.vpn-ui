# ===========================================================================
# vpn-ui panel + SNI-Spoofing-Go in ONE image.
#
#   sni-spoofing  ->  127.0.0.1:2020  (loopback only; never exposed)
#   vpn-ui panel  ->  0.0.0.0:2083    (map this port; change it in the panel UI)
#
# amd64 ONLY. Upstream publishes a single vpn-ui-amd64 asset and no arm64 build.
#
# READ THIS BEFORE DEPLOYING. vpn-ui is a 3x-ui fork whose selling point is
# L2TP, PPTP, OpenVPN, OpenConnect, SSTP, IKEv2, WireGuard and AmneziaWG. Those
# need CAP_NET_ADMIN, /dev/net/tun, kernel modules and systemd daemons, and
# upstream installs them with a host deploy.sh -- it ships no container support
# at all. In a container without NET_ADMIN, only the Xray-core protocols
# (VLESS, VMess, Trojan, Shadowsocks, AnyTLS, TUIC, NaiveProxy...) can work, and
# those are what plain 3x-ui already gives you. Run `sni-check` after starting
# to see what the platform actually granted.
#
# The Xray core and geofiles are bundled inside the panel binary, so unlike
# Dockerfile.3x-ui there is no separate tarball to unpack.
#
# Same three deliberate omissions as Dockerfile -- do not "modernise" them:
#   * no `# syntax=` line  -> never pulls the docker/dockerfile frontend image
#   * no heredoc           -> works on old builders and behind registry mirrors
#   * no Go build          -> never contacts proxy.golang.org (403 in Iran)
#
#   https://github.com/aleskxyz/SNI-Spoofing-Go  (GPL-3.0)
#   https://github.com/Sir-MmD/vpn-ui            (GPL-3.0)
# ===========================================================================

# --------------------------- download stage -------------------------------
FROM debian:bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl && rm -rf /var/lib/apt/lists/*

ARG REF=latest
ARG VPNUI_REF=latest
ARG TARGETARCH

# No `#` comments inside the RUN below: Docker joins continuation lines into a
# single shell line, so a comment would swallow everything after it.
RUN set -eu; \
    if [ "${TARGETARCH:-amd64}" != "amd64" ]; then \
      echo "vpn-ui publishes an amd64 binary only (got ${TARGETARCH})" >&2; exit 1; \
    fi; \
    if [ "$REF" = "latest" ]; then \
      SNI_URL="https://github.com/aleskxyz/SNI-Spoofing-Go/releases/latest/download/sni-spoofing-linux-amd64"; \
    else \
      SNI_URL="https://github.com/aleskxyz/SNI-Spoofing-Go/releases/download/${REF}/sni-spoofing-linux-amd64"; \
    fi; \
    if [ "$VPNUI_REF" = "latest" ]; then \
      PANEL_URL="https://github.com/Sir-MmD/vpn-ui/releases/latest/download/vpn-ui-amd64"; \
    else \
      PANEL_URL="https://github.com/Sir-MmD/vpn-ui/releases/download/${VPNUI_REF}/vpn-ui-amd64"; \
    fi; \
    mkdir -p /out; \
    echo "downloading ${SNI_URL}"; \
    curl -fL --retry 3 -o /out/sni-spoofing "$SNI_URL"; \
    echo "downloading ${PANEL_URL}"; \
    curl -fL --retry 3 -o /out/vpn-ui "$PANEL_URL"; \
    chmod +x /out/sni-spoofing /out/vpn-ui; \
    test -s /out/vpn-ui

# ---------------------------- runtime stage -------------------------------
FROM debian:bookworm-slim

# Debian 12 is one of the distributions upstream tests on, which is why this
# image is not Alpine. iptables/iproute2 are for the active injector; the
# second line is the debugging toolbox; the third is what the panel wants.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates iptables iproute2 libcap2-bin tini \
        iputils-ping dnsutils netcat-openbsd traceroute net-tools tcpdump \
        procps curl wget nano vim-tiny less \
        tzdata openssl bash cron \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/sni-spoofing /usr/local/bin/sni-spoofing
COPY --from=build /out/vpn-ui /app/vpn-ui

# The panel unpacks its bundled cores into ./bin, so WORKDIR matters. Without
# VPNUI_DB_FOLDER the database lands next to the binary in /app, which is not
# the volume -- so it is pinned to /etc/vpn-ui below.
RUN mkdir -p /data /etc/vpn-ui /var/log/vpn-ui /app/bin
WORKDIR /app

RUN set -eu; printf '%s' \
    IyEvYmluL3NoCiMgdnBuLXVpIHBhbmVsICsgc25pLXNwb29maW5nIGluIG9uZSBjb250YWluZXIuCiMKIyAgIHNuaS \
    1zcG9vZmluZyAgLT4gIHN0YXJ0cyBvbmx5IHdoZW4gQ09OTkVDVCBpcyBzZXQsIGluIHRoZSBiYWNrZ3JvdW5kLAoj \
    ICAgICAgICAgICAgICAgICAgICAgbGlzdGVuaW5nIG9uIDEyNy4wLjAuMToyMDIwIGJ5IGRlZmF1bHQgc28gdGhlIH \
